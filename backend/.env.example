APP_NAME=OrderMind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=ordermind
DB_USERNAME=ordermind
# Public development-only value, matching docker-compose.yml. Never use in production.
DB_PASSWORD=local-development-only
DATABASE_URL=
DB_SSLMODE=prefer

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=database
MAIL_MAILER=log
SANCTUM_EXPIRATION=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT=10
GEMINI_MAX_TOOL_ITERATIONS=3
GEMINI_HISTORY_MESSAGES=10
GEMINI_HISTORY_CHARACTERS=1200
